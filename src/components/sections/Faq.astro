---
import { faq } from '../../data/faq.js';
---
<section class="sec" id="faq" aria-labelledby="faq-title">
  <div class="faq">
    <div class="faq-head gut" data-reveal-group="up" data-reveal-stagger="110">
      <span class="label mono"><i class="o"></i>FAQ</span>
      <h2 id="faq-title">Questions, answered</h2>
    </div>
    <div class="faq-list" data-reveal-group="up" data-reveal-stagger="70">
      {faq.map(({ q, a }, i) => (
        <details class="faq-item" open={i === 0}>
          <summary><h3>{q}</h3><i aria-hidden="true"></i></summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
