# Webhook that receives the "Book a demo" form. In CI this is the repo variable PUBLIC_DEMO_FORM_HOOK.
PUBLIC_DEMO_FORM_HOOK=

# Public origin this build is served from. Default: https://lemnisca.dev.corevoice.in
SITE_URL=

# Set to true ONLY for the production build. Anything else is noindex + robots Disallow.
SITE_INDEXABLE=false

# Sub-path the site is served under. Default: /
BASE_PATH=
